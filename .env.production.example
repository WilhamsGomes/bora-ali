# Configuração de produção do docker-compose.yml da raiz. Copie para .env (nunca versione o .env).
#   cp .env.production.example .env
# DATABASE_URL, CORS_ORIGINS, FRONTEND_URL, TRUST_PROXY, COOKIE_SECURE e NODE_ENV são montados pelo compose.

# ───────────── Domínios e portas ─────────────
WEB_DOMAIN=boraali.wilhamsdev.com.br
API_DOMAIN=api-boraali.wilhamsdev.com.br
# Portas no host (só 127.0.0.1), para o Nginx encaminhar. Livres na VM: 3000–3006 já estão em uso.
WEB_PORT=3008
API_PORT=3007

# ───────────── Banco ─────────────
# Use só letras e números (vai dentro da URL de conexão). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# ───────────── Autenticação ─────────────
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Frontend e API são subdomínios do mesmo site (wilhamsdev.com.br): lax funciona.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ───────────── Execução ─────────────
# A própria API processa a fila de IA e a limpeza do cache de buscas (sem contêiner de worker separado).
RUN_WORKERS=true
LOG_FORMAT=json
LOG_LEVEL=log

# ───────────── E-mail (convites) ─────────────
# resend = envio real · none = convites respondem 503 (dev não é aceito em produção)
EMAIL_PROVIDER=none
EMAIL_FROM="BoraAli <convites@wilhamsdev.com.br>"
RESEND_API_KEY=

# ───────────── IA ─────────────
# Em produção só anthropic é aceito; sem ANTHROPIC_API_KEY a IA aparece como indisponível.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TRIP_BUDGET=1.50

# ───────────── Busca de locais (Geoapify, só no backend) ─────────────
GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=

# ───────────── Mapa (frontend, embutido no build) ─────────────
# Vazio = OpenFreeMap (sem chave). "off" desativa o mapa.
NEXT_PUBLIC_MAP_STYLE_URL=
