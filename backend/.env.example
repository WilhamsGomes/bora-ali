# ───────────── Aplicação ─────────────
# development | test | production
NODE_ENV=development
PORT=3333
# Origem(ns) do frontend permitidas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# URL pública do frontend (links de convite, retorno do checkout)
FRONTEND_URL=http://localhost:3000
# Número de proxies confiáveis à frente da API (0 = nenhum). Necessário para IP correto no rate limiting.
TRUST_PROXY=0
# Logger padrão do Nest: verbose | debug | log | warn | error | fatal | silent
# Formato: pretty (texto colorido do Nest) | json (uma linha JSON por evento, para agregadores)
LOG_FORMAT=pretty
LOG_LEVEL=log
# Processa trabalhos de IA e reconciliação no mesmo processo da API.
# Em produção, prefira false na API e rode o worker separado (npm run start:worker).
RUN_WORKERS=true

# ───────────── Banco ─────────────
DATABASE_URL=postgresql://boraali:boraali@localhost:5432/boraali?schema=public

# ───────────── Autenticação ─────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookie do refresh token (httpOnly). Em produção com frontend em outro site: COOKIE_SECURE=true e COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ───────────── E-mail ─────────────
# resend = envio real pelo Resend · dev = caixa de saída em memória (só development/test; GET /api/v1/dev/outbox)
# none = sem provedor. Sem configuração válida, convites respondem 503 EMAIL_DELIVERY_UNAVAILABLE (nada é simulado).
EMAIL_PROVIDER=dev
# Remetente com domínio verificado no Resend. Obrigatório com EMAIL_PROVIDER=resend.
EMAIL_FROM="BoraAli <convites@seu-dominio-verificado.com>"
# Chave da API do Resend (re_...). Nunca versione nem registre em log.
RESEND_API_KEY=
# Intervalo mínimo entre envios do mesmo convite e máximo de envios por convite.
INVITATION_RESEND_MIN_INTERVAL_SECONDS=60
INVITATION_MAX_SENDS=5

# ───────────── Stripe (somente modo teste) ─────────────
# Chave secreta de teste (sk_test_...). Chaves live são recusadas fora de produção.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...). Com a Stripe CLI: stripe listen --forward-to localhost:3333/api/v1/billing/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# IDs dos preços (BRL, pagamento único). Crie com: npm run stripe:setup
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_AI=
STRIPE_PRICE_UPGRADE_PRO_AI=
# Validade da sessão de checkout em minutos (30 a 1440)
CHECKOUT_SESSION_TTL_MINUTES=60

# ───────────── IA ─────────────
# anthropic | mock (mock só é aceito em development/test)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Modelo: precisa ter preço no catálogo (claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5) ou em AI_PRICING_JSON.
AI_MODEL=claude-opus-5-5
# Esforço (só enviado a modelos que aceitam effort): low | medium | high | xhigh | max
AI_EFFORT=medium
AI_TIMEOUT_MS=120000
# Novas tentativas SÓ para erros transitórios (rede, 429 com retry-after, 5xx/529), com backoff exponencial.
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=1000
# Espera máxima aceita entre tentativas (inclui retry-after); acima disso a geração falha.
AI_MAX_RETRY_WAIT_MS=30000

# Cotas funcionais por viagem (gerações concluídas). CONFIGURAÇÃO INICIAL CONSERVADORA — premissas no README.
AI_LIMIT_DAY_SUGGESTIONS=10
AI_LIMIT_TRIP_SUGGESTIONS=1
AI_LIMIT_ADJUST_ITINERARY=5

# Limites de tamanho por pedido/resposta
AI_MAX_PROMPT_CHARS=500
AI_MAX_DAYS_PER_GENERATION=7
AI_DAYS_PER_CALL=3
AI_MAX_CONTEXT_ACTIVITIES_PER_DAY=25
AI_MAX_SUGGESTIONS_PER_DAY=5
AI_MAX_ADJUST_CHANGES=10
AI_MAX_OUTPUT_TOKENS=8000

# Custo: catálogo padrão com preços oficiais conferidos em 2026-10-07 (USD por milhão de tokens).
# Para outro modelo ou preços atualizados, informe JSON + data de referência, ex.:
# AI_PRICING_JSON={"claude-sonnet-5-5":{"inputPerMTok":2,"outputPerMTok":10,"cacheWritePerMTok":2.5,"cacheReadPerMTok":0.2,"supportsEffort":true,"maxOutputTokens":128000}}
# AI_PRICING_REFERENCE_DATE=2026-10-07
AI_PRICING_JSON=
AI_PRICING_REFERENCE_DATE=
AI_PRICING_CURRENCY=USD
# Orçamento interno máximo de IA por viagem, na moeda de preços. Não é exibido ao usuário.
AI_TRIP_BUDGET=1.50

# ───────────── Limites de produto ─────────────
MAX_TRIP_DAYS=60

# ───────────── Busca de locais (Geoapify) ─────────────
# geoapify = autocomplete real · none = desativado (a busca responde 503 LOCATION_SEARCH_UNAVAILABLE e
# as atividades continuam aceitando local só em texto). Nada é simulado.
GEOCODING_PROVIDER=geoapify
# Chave da Geoapify SÓ do backend (myprojects.geoapify.com → projeto → API keys). Nunca vai para o navegador
# nem para logs. Sem ela, a busca fica indisponível (503) e o app mostra isso explicitamente.
GEOAPIFY_API_KEY=
# Tempo máximo por consulta ao provedor (ms)
GEOCODING_TIMEOUT_MS=4000
# Cache das buscas em duas camadas (os termos da Geoapify permitem armazenar resultados):
# 1) memória do processo (rápida; some ao reiniciar). 0 desativa.
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_CACHE_MAX_ENTRIES=2000
# 2) banco (tabela PlaceSearchCache; compartilhada entre instâncias e persistente). Dias de validade; 0 desativa.
GEOCODING_DB_CACHE_TTL_DAYS=90
# Consultas ao provedor por usuário por minuto (cache não conta). A rota também tem limite por IP (60/min).
GEOCODING_USER_LIMIT_PER_MINUTE=40
