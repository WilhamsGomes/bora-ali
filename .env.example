# URL base da API do BoraAli (inclui /api/v1). Pública: vai para o navegador; nunca coloque segredos aqui.
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1

# ───────────── Mapa (tiles) ─────────────
